    "./default/pages/Index": "./themes/default/pages/Index.tsx",
    "./default/pages/Post": "./themes/default/pages/Post.tsx",
    "./default/pages/Page": "./themes/default/pages/Page.tsx",
    "./default/pages/Tag": "./themes/default/pages/Tag.tsx",
    "./default/pages/Author": "./themes/default/pages/Author.tsx",
    "./default/pages/Archive": "./themes/default/pages/Archive.tsx",
    "./default/pages/Error": "./themes/default/pages/Error.tsx"
