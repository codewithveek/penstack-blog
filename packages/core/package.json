{
  "name": "@cms/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db/client": "./src/db/client.ts",
    "./db/schema": "./src/db/schema/index.ts",
    "./errors": "./src/errors/index.ts",
    "./types/*": "./src/types/*.ts",
    "./validators/*": "./src/validators/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./content/*": "./src/content/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:gen": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "latest",
    "zod": "latest",
    "bcryptjs": "latest",
    "date-fns": "latest",
    "uuid": "latest"
  },
  "peerDependencies": {
    "mysql2": "*"
  },
  "devDependencies": {
    "@types/bcryptjs": "latest",
    "@types/uuid": "latest",
    "drizzle-kit": "^0.31.9",
    "tsx": "latest",
    "typescript": "latest"
  }
}
