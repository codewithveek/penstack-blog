DB_NAME=  # Required
DB_PORT= # Required
DB_USER_NAME= # Required
DB_SSL_CONFIG={"rejectUnauthorized":true}
DB_USER_PASS= # Required
DB_HOST= # Required
NEXTAUTH_URL= # Required
# Generate a secure secret with: openssl rand -base64 32
# Or use: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET= # Required - DO NOT use the example value in production
GITHUB_ID= # Required
GITHUB_SECRET= # Required
GOOGLE_CLIENT_ID= # Required
GOOGLE_CLIENT_SECRET= # Required
ADMIN_EMAIL= # Required
ADMIN_PASSWORD= # Required
NEXT_PUBLIC_SITE_URL= # Not  Required, NEXT_AUTH_URL will be used if not provided
CRON_JOB_API_KEY= # Required
ENCRYPTION_KEY= # Required, a 32 byte (64 character) hex string - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
